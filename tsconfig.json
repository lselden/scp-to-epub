{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "target": "esnext",
    "checkJs": true,
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "outDir": "dist"
  },
  "exclude": [
    "node_modules"
  ],
  "compileOnSave": true,
  "typeAcquisition": {"enable": true}
}