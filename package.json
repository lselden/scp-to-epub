{
    "name": "scp-to-epub",
    "version": "2.0.0",
    "description": "Generate ebooks from scp foundation wiki articles",
    "main": "index.js",
    "type": "module",
    "bin": "dist/index.js",
    "types": "index.d.ts",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "pkg": "cd ./build/staging && pkg . --targets node24-win --out-path ../release --options use-env-proxy --sea",
        "build": "tsdown",
        "package": "pwsh scripts/build.ps1 -CopyPuppeteerArtifacts"
    },
    "pkg": {
        "assets": [
            "/node_modules/@img/**",
            "assets/**/*",
            "static/**/*"
        ]
    },
    "author": "Luke Selden",
    "license": "CC-BY-3.0",
    "devDependencies": {
        "@types/archiver": "^7.0.0",
        "@types/mime": "^3.0.4",
        "@types/node": "^24.12.4",
        "@yao-pkg/pkg": "^6.10.1",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "archiver": "^8.0.0",
        "dot-prop": "^10.1.0",
        "gray-matter": "^4.0.2",
        "js-yaml": "^4.1.0",
        "junk": "^4.0.1",
        "markdown-it": "^14.1.1",
        "markdown-it-attrs": "^5.0.0",
        "mime": "^4.1.0",
        "p-map": "^7.0.4",
        "puppeteer": "^25.1.0",
        "sharp": "^0.34.5",
        "tsdown": "^0.22.0",
        "yargs": "^18.0.0"
    }
}
